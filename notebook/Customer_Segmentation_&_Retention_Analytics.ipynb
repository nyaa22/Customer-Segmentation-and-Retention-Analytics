    {
      "cell_type": "code",
      "source": [
        "scaler = StandardScaler()\n",
        "rfm_scaled = scaler.fit_transform(rfm)\n",
        "\n",
        "\n",
        "kmeans = KMeans(n_clusters=4, random_state=42)\n",
        "rfm[\"Cluster\"] = kmeans.fit_predict(rfm_scaled)"
      ],
      "metadata": {
        "id": "TxgQADfqqYpt"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "segment_summary = rfm.groupby(\"Cluster\").mean()\n",
        "segment_summary\n",
        "\n",
        "\n",
        "segment_summary.to_csv(\"segment_profiles.csv\") # Changed path to current directory"
      ],
